@page
@model InventoryTracker.Web.Pages.Inventory.IndexModel

@{
    ViewData["Title"] = "Inventory";
}

<h1>Inventory</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Reorder Level</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.InventoryItems)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.CategoryName</td>
                <td>@item.Quantity</td>
                <td>@item.ReorderLevel</td>
                <td>@item.IsActive</td>
                <td>
                    <a asp-page="./Details"
                        asp-route-id="@item.InventoryItemId">
                            Details
                    </a>

                    <a asp-page=".\Edit"
                        asp-route-id="@item.InventoryItemId">
                            Edit
                    </a>

                    <a asp-page=".\Delete"
                        asp-route-id="@item.InventoryItemId">
                            Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
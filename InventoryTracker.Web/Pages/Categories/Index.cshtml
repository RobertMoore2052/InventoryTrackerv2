@page
@model InventoryTracker.Web.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<a asp-page="./Create" class="btn btn-primary">
    Add Category
</a>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Inventory Items</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model.Categories)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.InventoryItemCount</td>
                <td>
                    <a asp-page=".\Edit"
                            asp-route-id="@category.CategoryId">
                        Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

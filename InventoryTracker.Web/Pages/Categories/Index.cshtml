@page
@model InventoryTracker.Web.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Categories</h1>

    <a asp-page="./Create"
        class="btn btn-primary">
            Add Category
    </a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Inventory Items</th>
            <th></th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model.Categories)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.InventoryItemCount</td>
                <td>
                    <a asp-page="./Edit"
                            asp-route-id="@category.CategoryId">
                        Edit
                    </a>
                </td>
                <td>
                    <a asp-page="./Delete"
                            asp-route-id="@category.CategoryId">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
